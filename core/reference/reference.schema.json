{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://numislens.local/schemas/reference.schema.json",
  "title": "NumisLens Value Reference",
  "description": "Curated, source-cited value data for one series. Read-time estimates only: exact-match lookups, no interpolation; grade-null entries are worklist flags, never values.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "name", "series", "source", "entries"],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1,
      "description": "Dataset format version."
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Stable identifier (e.g. filename stem)."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Human-readable dataset title."
    },
    "series": {
      "type": "string",
      "minLength": 1,
      "description": "Canonical series name matching coins.series in the ledger (case-insensitive at lookup)."
    },
    "country": {
      "type": "string",
      "enum": ["US"],
      "default": "US",
      "description": "Only US datasets are supported today (face-value and quick-add vocabularies are US-scoped)."
    },
    "denomination": {
      "type": "string",
      "description": "Informational denomination label."
    },
    "notable_threshold_cents": {
      "type": "integer",
      "minimum": 1,
      "default": 100,
      "description": "Entries at or above this value define notable identities for the appraisal worklist."
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url", "retrieved"],
      "description": "MANDATORY provenance: every figure traces to this citation.",
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "pattern": "^https?://" },
        "retrieved": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "notes": { "type": "string" }
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["year", "value_cents"],
        "properties": {
          "year": { "type": "integer", "minimum": 1600, "maximum": 2100 },
          "mintmark": {
            "type": ["string", "null"],
            "enum": ["P", "D", "S", "O", "CC", "W", null],
            "description": "null = wildcard: matches any coin mintmark including none."
          },
          "grade": {
            "type": ["string", "null"],
            "enum": ["AG", "G", "VG", "F", "VF", "XF", "AU", "UNC", "PROOF", null],
            "description": "Exact bucket for value lookups. null = flag-only entry ('any condition'), never a reported value."
          },
          "value_cents": { "type": "integer", "minimum": 1 },
          "note": { "type": "string" }
        }
      }
    }
  }
}
