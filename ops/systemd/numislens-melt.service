[Unit]
Description=NumisLens daily melt-value update (dual-source keyless spot fetch)
Documentation=https://github.com/bedardandy/numislens
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# numislens resolves its DB at ~/.local/share/numislens/numislens.db by default.
# Set NUMISLENS_DB to override, or pass --db in ExecStart.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/numislens melt update
ExecStartPost=%h/.local/bin/numislens melt status
# Fail loud: a non-zero exit (source disagreement, staleness, network) is surfaced by systemd.

[Install]
WantedBy=default.target
